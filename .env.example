# Civico development environment

# PostgreSQL
POSTGRES_USER=civico
POSTGRES_PASSWORD=civico_dev
POSTGRES_DB=civico

# API
API_BIND=127.0.0.1:8080
DATABASE_URL=postgres://civico:civico_dev@127.0.0.1:5432/civico

# Frontend dev server URLs. dev.sh sets these automatically from API_BIND and
# the player port, but you can override them here if necessary.
VITE_API_URL=http://127.0.0.1:8080
VITE_PLAYER_URL=http://127.0.0.1:8081

# Secret used to sign admin session tokens (HS256). MUST be set to a long
# random value in any non-local deployment. Never commit it.
JWT_SECRET=change-me

# Directory where uploaded media files are stored on disk.
MEDIA_DIR=media

# Maximum accepted upload size in bytes (default 10 MiB).
MAX_UPLOAD_BYTES=10485760
